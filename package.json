{
  "name": "sababar-bnpl-sales-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "build": "npm run db:generate && npm run build:api && npm run build:web",
    "start": "npm run db:migrate:deploy && npm run start:prod",
    "dev:api": "npm run dev --workspace bnpl-sales-api",
    "dev:web": "npm run dev --workspace bnpl-sales-web",
    "build:api": "npm run build --workspace bnpl-sales-api",
    "build:web": "npm run build --workspace bnpl-sales-web",
    "start:prod": "npm run start --workspace bnpl-sales-api",
    "test:unit": "npm run test:unit --workspace bnpl-sales-api",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:all": "npm run test:unit && npm run test:smoke",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:generate": "npm run prisma:generate --workspace bnpl-sales-api",
    "db:migrate": "npm run prisma:migrate --workspace bnpl-sales-api",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace bnpl-sales-api"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.21.5": true,
    "prisma@6.19.3": true
  }
}
