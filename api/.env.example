NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5174
DATABASE_URL=postgresql://bnpl_sales:replace-me@localhost:5433/bnpl_sales?schema=public
SESSION_TTL_HOURS=12
FILE_STORAGE_DIR=./private-files
# Liara Object Storage (keep the bucket private; use the SDK endpoint shown in bucket settings)
LIARA_ENDPOINT=https://your-bucket-sdk-endpoint
LIARA_BUCKET_NAME=driver-documents
LIARA_ACCESS_KEY=server-only-access-key
LIARA_SECRET_KEY=server-only-secret-key
# Legacy read-only settings for files uploaded to Supabase before migrating to Liara
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_STORAGE_BUCKET=driver-documents
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
MAX_DOCUMENT_BYTES=20971520
MAX_VIDEO_BYTES=157286400
BOOTSTRAP_TOKEN=replace-with-a-random-secret-at-least-32-characters
